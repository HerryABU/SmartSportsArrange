# ============================================================
# SmartSportsArrange - .gitignore
# ============================================================

# ---------- Build artifacts ----------
# Maven (backend)
sports-backend/target/
*.class

# Node / Vite (frontend)
sports-frontend/node_modules/
sports-frontend/dist/
sports-frontend/.vite/

# Packaged executable JAR (regenerated by build.ps1)
*.jar
sports-1.0.0.jar

# Original project skeleton archive (superseded by current source)
starter.zip

# ---------- Runtime data & local database ----------
# Embedded SQLite DB (auto-recreated on first launch)
sports_meet.db
sports_meet.db-shm
sports_meet.db-wal

# Runtime data directories - ignore runtime contents, keep folder structure
data/logs/*
data/exports/*
data/uploads/*
data/backup/*
data/avatars/*
!data/**/.gitkeep
*.log

# ---------- Secrets / environment ----------
.env
.env.*
*.local

# ---------- IDE ----------
.idea/
.vscode/
*.iml
*.swp

# ---------- OS ----------
.DS_Store
Thumbs.db
ehthumbs.db
