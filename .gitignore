# ============================================================
# SmartSportsArrange - .gitignore
# ============================================================

# ---------- Build artifacts ----------
# Maven (backend)
sports-backend/target/
target_old*/
*.class

# Node / Vite (frontend)
sports-frontend/node_modules/
sports-frontend/dist/
dist_old*/

# 前端构建产物（已同步至后端静态资源目录，构建时生成，不纳入版本控制）
sports-backend/src/main/resources/static/
# 构建前重命名的旧静态目录（规避构建清空拦截，构建后清理）
static_old*/
sports-backend/src/main/resources/static_old/

# ---------- 工作区本地数据（记忆/技能等，不提交） ----------
.workbuddy/
sports-frontend/.vite/

# 一次性/垃圾目录（清理时临时存放，不入版本库）
_trash/
_trash_*/
_cleanup_*/

# Packaged executable JAR (regenerated by build.ps1)
*.jar
sports-2.0.0.jar

# Original project skeleton archive (superseded by current source)
starter.zip

# ---------- Runtime data & local database ----------
# Embedded SQLite DB (auto-recreated on first launch)
sports_meet.db
sports_meet.db-shm
sports_meet.db-wal
# 手工对比基线快照（一次性测试产物，不入版本库）
_baseline_meet.db
# SQLite 物理外键迁移前的自动备份（SqliteForeignKeyMigrator 生成）
*.fkbackup-*

# 运行时 data 目录整体忽略：数据库、安装配置、日志、上传/导出/备份、
# 头像、Word 秩序册落盘等全部为运行时生成，一律不入版本库
data/
*.log

# ---------- Secrets / environment ----------
.env
.env.*
*.local

# ---------- IDE ----------
.idea/
.vscode/
*.iml
*.swp

# ---------- OS ----------
.DS_Store
Thumbs.db
ehthumbs.db

# backend runtime logs from tests/boot
sports-backend/data/
smoke_e2e/
# build.ps1 把被替换的前端产物 / 残留 static_old_* 先挪到这里（重命名不被安全删除守卫拦）
_trash/

# ---------- sports-ai 训练侧源码 ----------
# 上面的 data/ 规则会误伤 sports-ai/sports_ai/data 包（特征契约源码），显式放回；
# 训练权重 *.pt 由 sports-ai/.gitignore 忽略，部署模型 *.onnx 纳入版本控制。
!sports-ai/
!sports-ai/sports_ai/data/
!sports-ai/sports_ai/data/**
# 训练覆盖保护产生的自动备份（sports_ai.device.backup_before_overwrite）
sports-ai/models/*.pt.bak.*
sports-ai/models/*.pt.bak.smoke-*
